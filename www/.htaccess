RewriteEngine On
RewriteBase /

RewriteRule ^api/run$ mifrial/API/action.php [L,QSA]
RewriteRule ^api/chat/sync$ mifrial/API/chat-sync.php [L,QSA]
RewriteRule ^api/game/sync$ mifrial/API/game-sync.php [L,QSA]
RewriteRule ^api/file/upload$ mifrial/API/file-upload.php [L,QSA]
RewriteRule ^api/file/([a-f0-9]{32})$ mifrial/API/file-get.php?publicId=$1 [L,QSA]

SetEnvIf Request_URI "^/api/chat/sync$" no-gzip=1
SetEnvIf Request_URI "^/api/game/sync$" no-gzip=1

RewriteRule ^mifrial/(?!API/(?:action|chat-sync|game-sync|file-upload|file-get)\.php$) - [F,L,NC]
