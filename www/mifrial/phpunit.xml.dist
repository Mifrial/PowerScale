<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="kernel">
            <directory>modules/Core/Kernel/tests</directory>
        </testsuite>
        <testsuite name="smarttable">
            <directory>modules/Core/SmartTable/tests</directory>
        </testsuite>
        <testsuite name="agent">
            <directory>modules/Core/Agent/tests</directory>
        </testsuite>
        <testsuite name="user">
            <directory>modules/Core/User/tests</directory>
        </testsuite>
        <testsuite name="auth">
            <directory>modules/Core/Auth/tests</directory>
        </testsuite>
        <testsuite name="mail">
            <directory>modules/Core/Mail/tests</directory>
        </testsuite>
        <testsuite name="logger">
            <directory>modules/Core/Logger/tests</directory>
        </testsuite>
        <testsuite name="cache">
            <directory>modules/Core/Cache/tests</directory>
        </testsuite>
        <testsuite name="chat">
            <directory>modules/Messages/Chat/tests</directory>
        </testsuite>
        <testsuite name="versioning">
            <directory>modules/Versioning/Space/tests</directory>
        </testsuite>
        <testsuite name="keyword">
            <directory>modules/Roleplay/Keyword/tests</directory>
        </testsuite>
        <testsuite name="mechanic">
            <directory>modules/Roleplay/Mechanic/tests</directory>
        </testsuite>
        <testsuite name="rule">
            <directory>modules/Roleplay/Rule/tests</directory>
        </testsuite>
        <testsuite name="rulespace">
            <directory>modules/Roleplay/RuleSpace/tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="MIFRIAL_CONFIG" value="test" force="true"/>
    </php>
</phpunit>
