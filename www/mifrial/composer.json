{
  "name": "powerscale/mifrial",
  "description": "PowerScale PHP runtime (Mifrial)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "illuminate/database": "^11.0"
  },
  "suggest": {
    "ext-redis": "Core/Cache redis driver"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^10.5",
    "slevomat/coding-standard": "^8.31",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "cs-check": "php-cs-fixer fix --dry-run --diff && phpcs",
    "cs-fix": "php-cs-fixer fix && phpcbf",
    "quality": "phpcs --standard=phpcs-quality.xml.dist"
  },
  "autoload": {
    "psr-4": {
      "Mifrial\\Core\\Kernel\\": "modules/Core/Kernel/",
      "Mifrial\\Core\\SmartTable\\": "modules/Core/SmartTable/",
      "Mifrial\\Core\\Agent\\": "modules/Core/Agent/",
      "Mifrial\\Core\\User\\": "modules/Core/User/",
      "Mifrial\\Core\\Auth\\": "modules/Core/Auth/",
      "Mifrial\\Core\\Mail\\": "modules/Core/Mail/",
      "Mifrial\\Core\\Logger\\": "modules/Core/Logger/",
      "Mifrial\\Core\\Cache\\": "modules/Core/Cache/",
      "Mifrial\\Messages\\Chat\\": "modules/Messages/Chat/",
      "Mifrial\\Versioning\\Space\\": "modules/Versioning/Space/",
      "Mifrial\\Roleplay\\Keyword\\": "modules/Roleplay/Keyword/",
      "Mifrial\\Roleplay\\Mechanic\\": "modules/Roleplay/Mechanic/",
      "Mifrial\\Roleplay\\Rule\\": "modules/Roleplay/Rule/",
      "Mifrial\\Roleplay\\RuleSpace\\": "modules/Roleplay/RuleSpace/",
      "Mifrial\\Roleplay\\Character\\": "modules/Roleplay/Character/"
    },
    "exclude-from-classmap": [
      "/modules/Core/Kernel/tests/",
      "/modules/Core/SmartTable/tests/",
      "/modules/Core/Agent/tests/",
      "/modules/Core/User/tests/",
      "/modules/Core/Auth/tests/",
      "/modules/Core/Mail/tests/",
      "/modules/Core/Logger/tests/",
      "/modules/Core/Cache/tests/",
      "/modules/Messages/Chat/tests/",
      "/modules/Versioning/Space/tests/",
      "/modules/Roleplay/Keyword/tests/",
      "/modules/Roleplay/Mechanic/tests/",
      "/modules/Roleplay/Rule/tests/",
      "/modules/Roleplay/RuleSpace/tests/",
      "/modules/Roleplay/Character/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MifrialCodingStandard\\": "tools/phpcs/MifrialCodingStandard/",
      "Mifrial\\Core\\Kernel\\Tests\\": "modules/Core/Kernel/tests/",
      "Mifrial\\Core\\SmartTable\\Tests\\": "modules/Core/SmartTable/tests/",
      "Mifrial\\Core\\Agent\\Tests\\": "modules/Core/Agent/tests/",
      "Mifrial\\Core\\User\\Tests\\": "modules/Core/User/tests/",
      "Mifrial\\Core\\Auth\\Tests\\": "modules/Core/Auth/tests/",
      "Mifrial\\Core\\Mail\\Tests\\": "modules/Core/Mail/tests/",
      "Mifrial\\Core\\Logger\\Tests\\": "modules/Core/Logger/tests/",
      "Mifrial\\Core\\Cache\\Tests\\": "modules/Core/Cache/tests/",
      "Mifrial\\Messages\\Chat\\Tests\\": "modules/Messages/Chat/tests/",
      "Mifrial\\Versioning\\Space\\Tests\\": "modules/Versioning/Space/tests/",
      "Mifrial\\Roleplay\\Keyword\\Tests\\": "modules/Roleplay/Keyword/tests/",
      "Mifrial\\Roleplay\\Mechanic\\Tests\\": "modules/Roleplay/Mechanic/tests/",
      "Mifrial\\Roleplay\\Rule\\Tests\\": "modules/Roleplay/Rule/tests/",
      "Mifrial\\Roleplay\\RuleSpace\\Tests\\": "modules/Roleplay/RuleSpace/tests/",
      "Mifrial\\Roleplay\\Character\\Tests\\": "modules/Roleplay/Character/tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
