{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vue-mcp": {
      "type": "remote",
      "url": "http://localhost:3000/__mcp/sse",
      "enabled": true
    },
    "vue-docs-mcp": {
      "type": "remote",
      "url": "https://mcp.vue-mcp.org/mcp",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": ".opencode/memory.jsonl"
      },
      "enabled": true
    }
  }
}
